# Production environment for the Keylo signing service.
# Copy to your secret manager / deployment platform. Never commit real secrets.

NODE_ENV=production
NEXT_PUBLIC_WEBAPP_URL=https://sign.keylo.fr
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=https://sign.keylo.fr
PORT=3000

NEXTAUTH_SECRET=CHANGE_ME_32_BYTES
NEXT_PRIVATE_ENCRYPTION_KEY=CHANGE_ME_32_BYTES
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=CHANGE_ME_32_BYTES

# Managed PostgreSQL with backups and PITR.
NEXT_PRIVATE_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/KEYLO_DOCUMENSO
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/KEYLO_DOCUMENSO

KEYLO_PHONE_SIGNING_ENABLED=true

# S3-compatible storage with versioning and retention.
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_ENDPOINT=
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE=false
NEXT_PRIVATE_UPLOAD_REGION=auto
NEXT_PRIVATE_UPLOAD_BUCKET=keylo-documenso-production
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=CHANGE_ME
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME

# Transactional email with SPF/DKIM/DMARC configured.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=CHANGE_ME
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=CHANGE_ME
NEXT_PRIVATE_SMTP_PASSWORD=CHANGE_ME
NEXT_PRIVATE_SMTP_SECURE=true
NEXT_PRIVATE_SMTP_FROM_NAME=Keylo
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@keylo.fr

# Signing certificate. Use a managed secret and restrict access.
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_PASSPHRASE=CHANGE_ME
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/keylo/cert.p12
NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS=

# Public HTTPS API, so no SSRF bypass is needed.
NEXT_PRIVATE_WEBHOOK_SSRF_BYPASS_HOSTS=

NEXT_PUBLIC_DISABLE_SIGNUP=true
