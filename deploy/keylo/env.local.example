# Local Docker Compose stack for the Keylo signing service.
# Copy to env.local and replace every CHANGE_ME value.

# Public URL used by the browser and by signing links.
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3003
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3003
PORT=3003

# Auth / crypto. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME_32_BYTES
NEXT_PRIVATE_ENCRYPTION_KEY=CHANGE_ME_32_BYTES
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=CHANGE_ME_32_BYTES

# Database (inside the Compose network).
NEXT_PRIVATE_DATABASE_URL=postgres://documenso:password@database:5432/documenso
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgres://documenso:password@database:5432/documenso

# Phone-only signing (no OTP/SMS).
KEYLO_PHONE_SIGNING_ENABLED=true

# Local storage. Switch to s3 for staging/production.
NEXT_PUBLIC_UPLOAD_TRANSPORT=database

# Local email catcher (Mailpit UI on http://localhost:8025).
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=mailpit
NEXT_PRIVATE_SMTP_PORT=1025
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_FROM_NAME=Keylo
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@keylo.local

# Local signing certificate. Leave empty to let Documenso start without
# document signing, or mount a .p12 and point to it.
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_PASSPHRASE=
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=

# The Reylo API runs on the host during local development. Documenso's webhook
# SSRF guard must allow the Docker host alias to reach it.
NEXT_PRIVATE_WEBHOOK_SSRF_BYPASS_HOSTS=host.docker.internal

# Optional: disable public signup once the admin account exists.
NEXT_PUBLIC_DISABLE_SIGNUP=false
